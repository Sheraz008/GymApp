{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "paths": {
      "@assets/*": ["assets/*"],
      "@theme/*": ["shared/theme/*"],
      "@components/*": ["shared/components/*"],
      "@hooks/*": ["shared/hooks/*"],
      "@utils/*": ["shared/utils/*"],
      "@screens/*": ["screens/*"],
      "@config/*": ["shared/config/*"],
      "@shared/*": ["shared/*"],
      "@navigation/*": ["navigation/*"],
      "@providers/*": ["shared/providers/*"],
      "@query/*": ["shared/query/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "index.js"],
  "exclude": ["node_modules"]
}
